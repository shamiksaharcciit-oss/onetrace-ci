+
+        @_onetrace_rec.stage("retrieve", _OnetraceInstrument(
+            "word-overlap", "python-package", _onetrace_metadata.version("onetrace-verify"),
+            {"package": "onetrace-verify"}, rederivable="true"))
+        def _onetrace_stage_retrieve(_onetrace_ctx, *_onetrace_args, **_onetrace_kwargs):
+            _onetrace_ctx.read(_onetrace_out["intake"])
+            _onetrace_ctx.read_external(_ONETRACE_ROOT / "data/corpus.json", "application/json",
+                                        name="data/corpus.json", trust_class="operator-authored")
+            _onetrace_value = retrieve(*_onetrace_args, **_onetrace_kwargs)
+            _onetrace_out["retrieve"] = _onetrace_write(_onetrace_ctx, "retrieve", _onetrace_value)
