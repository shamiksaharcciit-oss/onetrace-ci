+        declared_stages=["intake", "retrieve", "answer"],
+        manifest=_OnetracePath(__file__), policy="fail-closed",
+        anchor_reason="epoch anchoring is not implemented", run_id=_onetrace_run)
+    _onetrace_out = {}
+    try:
+        @_onetrace_rec.stage("intake", _OnetraceInstrument(
