+        def _onetrace_stage_answer(_onetrace_ctx, *_onetrace_args, **_onetrace_kwargs):
+            _onetrace_ctx.read(_onetrace_out["retrieve"])
+            _onetrace_value = answer(*_onetrace_args, **_onetrace_kwargs)
+            _onetrace_out["answer"] = _onetrace_write(_onetrace_ctx, "answer", _onetrace_value)
+            return _onetrace_value
+
+        _onetrace_stage_intake()
+        passages = _onetrace_stage_retrieve(request)
+        return _onetrace_stage_answer(request, passages)
+    finally:
+        _onetrace_rec.close()
